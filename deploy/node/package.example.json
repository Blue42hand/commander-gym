{
  "version": 1,
  "service_user": "commander",
  "service_group": "commander",
  "commander_gym": {
    "root": "/opt/commander-gym",
    "revision": "1111111111111111111111111111111111111111"
  },
  "argentum": {
    "root": "/opt/argentum-engine",
    "revision": "2222222222222222222222222222222222222222"
  },
  "gateway_token_file": "/etc/commander-gym/gateway.token",
  "gateway": {
    "bind": "127.0.0.1",
    "port": 8082,
    "upstream": "http://127.0.0.1:8081"
  },
  "storage": {
    "root": "/var/lib/commander-gym",
    "routes": {
      "models": "/mnt/commander-gym-models",
      "cache": "/var/cache/commander-gym"
    }
  },
  "local_inference": {
    "command": ["/usr/local/bin/model-server", "serve"],
    "working_directory": "/var/lib/commander-gym/models",
    "environment_file": "/etc/commander-gym/model.env",
    "accelerator_probe": ["/usr/local/bin/check-accelerator"]
  }
}
